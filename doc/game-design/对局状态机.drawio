        </mxCell>
        <mxCell id="mod_pause" value="PAUSE 暂停&#10;房主暂停全场 → SceneTree.paused，任何状态冻结" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="mod_managed" value="MANAGED 托管&#10;超时 / 掉线 / 机器人：代掷、代决定、商店自动、赌场自动抽" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="mod_sleep" value="SLEEP 休眠（小黑屋）&#10;被动照算 + 系统代掷 + 拒绝买卖 + 跳过道具；商店 / 赌场自动离" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="mod_skip" value="SKIP 跳过回合&#10;宿委会反省：整回合不掷、不享被动、不用道具" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="mod_disc" value="DISCONNECTED 掉线&#10;→ 转托管；座位保留，整局可凭 token 重连认领" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="mod_bank" value="BANKRUPT 破产出局&#10;跳过、观战；清空道具（唯一件回池）、不可再用道具" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="300" height="100" as="geometry" /></mxCell>


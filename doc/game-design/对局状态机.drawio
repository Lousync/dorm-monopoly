  <diagram id="turn-state-machine" name="对局状态机（回合内）">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ 标题 / 图例 ============ -->
        <mxCell id="title" value="宿舍大富翁 · 对局状态机（回合内）&#10;依据 scripts/game.gd  _play_turn / _resolve_tile / _item_phase 与 doc/game-design/回合与行动.md&#10;蓝=阶段状态　紫虚=等待(await)　绿=子状态机　橙note=正交修饰状态　黄菱=分支判定　A/B/C=跨页连接点" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="100" as="geometry" />
        </mxCell>

        <!-- ============ 对局级 ============ -->
        <mxCell id="pre" value="PRE_GAME&#10;开局科技三选一（每人，rpc_id 私发）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="320" height="80" as="geometry" />
        </mxCell>

        <!-- ============ 主脊：回合循环 ============ -->
        <mxCell id="start" value="S0 回合开始结算&#10;体力+1 / 冷却−1 / 香皂融化−1 /&#10;信托基金+¥100 / 重置用具标记" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ab" value="S1 畸变窗口&#10;_aberration_window：全场畸变触发 / 持续 −1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tech" value="S2 掷轮前科技询问（可跳过）&#10;任意门 / 天命在握" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="440" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="roll" value="S3 ① 掷轮盘（await=roll）&#10;真人等待（超时 35s 代掷）/ 机器人 / 休眠 自动掷&#10;点数 0~12；强制点数类道具在此生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="580" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="rollres" value="S4 掷轮结果处理&#10;悔棋询问（≤6 点，黄金科技）/&#10;查寝判定（连续 3 次 10+ → 送监）/ 强制点数覆盖&#10;⚠ 查寝或送监：本回合提前终止（不进道具）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="770" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="move" value="S5 移动（自动）&#10;逐格动画；踏过起点领工资；兼职达人路过结算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="950" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="settle" value="S6 落地结算 _resolve_tile()&#10;按落点格型分派（见右）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="1090" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="item" value="S7 ② 使用道具（await=item）&#10;选牌 → 选目标 / 格 / 点数 → 生效&#10;每回合限 1 次；超时 12s 跳过；休眠 / 出局跳过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="1260" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="end" value="S8 回合结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="1450" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="next" value="S9 轮到下一位（跳过破产 / 出局）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="1580" width="400" height="70" as="geometry" />

# ---------------- Godot ----------------

# 编辑器缓存与导入产物（必需忽略；重新打开编辑器会自动重建）
.godot/

# 导出产物（用导出命令重新生成）
build/

# Godot 生成的导入元数据与脚本 UID：打开编辑器/执行 --import 会自动重建。
# 本项目全部资产都用默认导入设置（已核对 25 个 .import 的键完全一致），
# 重建结果与入库内容相同，故不入库。
#
# 注意：一旦有人改过某个资产的导入设置（压缩模式、过滤、尺寸等），
# 该设置就只存在于本机，不会随仓库共享——那时应把 *.import 改回入库。
*.import
*.uid

# ---------------- 本项目产物 ----------------

# 截图产物（--shot= 的输出目录，不是源码；曾误入库占了仓库打包体积的大头）
shots/

# 临时补丁脚本（一次性改写用，不长期保留）
_patch_*.py

# ---------------- 系统杂项 ----------------
Thumbs.db
.DS_Store

# ZCode 会话本地目录（计划草稿等，非项目源码）
.zcode/

# superpowers 技能的本地产物（头脑风暴画板 / 计划草稿，非项目源码）
.superpowers/

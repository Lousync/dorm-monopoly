; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="宿舍大富翁"
config/version="0.10.0"
config/description="宿舍主题大富翁，支持局域网 4 人联机与 IPv6 直连"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[autoload]

Net="*res://scripts/net.gd"
Fx="*res://scripts/fx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

; 4x MSAA（用户 2026-10-06：「卡牌堆边缘有锯齿」）。Compatibility 渲染器支持 3D MSAA；
; 关掉的话任何斜边都出锯齿 —— 牌堆这种**大块平色 + 直边斜着放**的东西最明显。
anti_aliasing/quality/msaa_3d=2

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
